<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Ai.SolidWorksAssistant</RootNamespace>
    <AssemblyName>AiSolidWorksAssistant</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>portable</DebugType>
    <Version>0.1.0</Version>
    <Description>AI SolidWorks Assistant — Phase 1 add-in foundation (task pane chat, model context, plan-script CAD command engine).</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="cad\PlanScript.md" />
    <EmbeddedResource Include="samples\plan.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\icons\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
